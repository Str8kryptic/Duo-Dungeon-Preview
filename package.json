{
  "name": "duo-dungeon",
  "version": "1.0.0",
  "private": true,
  "description": "Duo Dungeon mobile application shell",
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "android:add": "npm run build:web && cap add android && npm run android:configure",
    "android:sync": "npm run build:web && cap sync android && npm run android:configure",
    "android:open": "cap open android",
    "android:configure": "node scripts/prepare-android-health.mjs",
    "android:verify": "node scripts/verify-android-health-manifest.mjs",
    "test:guild": "node scripts/test-guild.mjs",
    "test:audio": "node --check audio-manager.js && node scripts/test-audio-manager.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capgo/capacitor-health": "^8.12.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
